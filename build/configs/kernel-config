#
# Hope OS Kernel Configuration
# linux-zen custom config with BFQ + localmodconfig base
# Targets: Desktop, <4s boot, low RAM, immutable-ready
#

CONFIG_LOCALVERSION="-hope"
CONFIG_LOCALVERSION_AUTO=n

# Boot
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=n
CONFIG_RANDOMIZE_BASE=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y

# CPU
CONFIG_SCHED_MUQSS=y
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_FULL=y

# I/O Scheduler (BFQ for desktop)
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_DEFAULT_BFQ=y

# Memory / Compression
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# Filesystems
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_BTRFS_FS_RUN_SANITY_TESTS=n
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y

# Networking
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_PCI=y
CONFIG_ETHERNET=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# Crypto
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# Security
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_DEBUG_RODATA=y

# DRM / GPU
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_NOUVEAU=y

# Wayland
CONFIG_WL_ROBOT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# USB / Input
CONFIG_USB_HID=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC3=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_LIBINPUT=y

# Virtualization
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y

# Debug (disabled for perf)
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_MISC=n

# Immutable system support
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIGOverlay_FS_METACOPY=y