# Hope OS udev rules for HAL+ hardware detection
# Triggers HAL+ when new hardware is detected

# USB devices
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", TAG+="hope-hal", RUN+="/usr/local/bin/hal-daemon --event=usb --vendor=%idVendor --product=%idProduct --device=%s/product"

# PCI devices  
ACTION=="add", SUBSYSTEM=="pci", TAG+="hope-hal", RUN+="/usr/local/bin/hal-daemon --event=pci --vendor=%idVendor --device=%idDevice"

# Block devices
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", TAG+="hope-hal", RUN+="/usr/local/bin/hal-daemon --event=block --device=%name"

# Network
ACTION=="add", SUBSYSTEM=="net", TAG+="hope-hal", RUN+="/usr/local/bin/hal-daemon --event=net --interface=%INTERFACE"